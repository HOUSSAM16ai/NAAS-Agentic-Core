{
  "name": "CogniForge Dev Environment",
  "dockerComposeFile": ["docker-compose.host.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  "remoteUser": "root",

  "remoteEnv": {
    "HOME": "/root",
    "PYTHONUNBUFFERED": "1",
    "PYTHONPATH": "/app",
    "ENVIRONMENT": "development",
    "APP_DATABASE_URL": "${localEnv:APP_DATABASE_URL}",
    "DATABASE_URL": "${localEnv:DATABASE_URL}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "SECRET_KEY": "${localEnv:SECRET_KEY}",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${localEnv:OTEL_EXPORTER_OTLP_ENDPOINT:http://localhost:4317}",
    "OTEL_EXPORTER_OTLP_INSECURE": "true",
    "OTEL_SERVICE_NAME": "cogniforge-monolith",
    "OBSERVABILITY_AUTOSTART": "${localEnv:OBSERVABILITY_AUTOSTART:1}"
  },

  "overrideCommand": true,
  "command": ["sleep", "infinity"],

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/on-start.sh",
  "postAttachCommand": "bash .devcontainer/on-attach.sh",

  "forwardPorts": [3001, 8000, 5000, 3000, 9090, 3200, 3100, 4317, 4318, 5432],
  "appPort": ["8000", "5000"],

  "portsAttributes": {
    "3001": {
      "label": "🛰️ Mission Control (Grafana)",
      "onAutoForward": "openBrowser",
      "visibility": "public",
      "protocol": "http"
    },
    "8000": {
      "label": "Backend API (FastAPI)",
      "onAutoForward": "notify",
      "visibility": "public",
      "protocol": "http"
    },
    "5000": {
      "label": "Frontend (Next.js)",
      "onAutoForward": "notify",
      "visibility": "public",
      "protocol": "http"
    },
    "3000": {
      "label": "Frontend (Next.js)",
      "onAutoForward": "notify",
      "visibility": "public",
      "protocol": "http"
    },
    "9090": {
      "label": "Prometheus (Raw Queries)",
      "onAutoForward": "silent",
      "visibility": "public",
      "protocol": "http"
    },
    "3200": {
      "label": "Tempo (Trace Backend)",
      "onAutoForward": "silent",
      "visibility": "private",
      "protocol": "http"
    },
    "3100": {
      "label": "Loki (Log Backend)",
      "onAutoForward": "silent",
      "visibility": "private",
      "protocol": "http"
    },
    "4317": {
      "label": "OTel Collector (gRPC)",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "4318": {
      "label": "OTel Collector (HTTP)",
      "onAutoForward": "silent",
      "visibility": "private",
      "protocol": "http"
    },
    "5432": {
      "label": "PostgreSQL (Internal)",
      "onAutoForward": "ignore"
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "root"
    }
    // INTENTIONALLY NO `docker-in-docker` / `docker-outside-of-docker`.
    // - `docker-in-docker:2` fails to build on `python:3.12-slim` +
    //   `network_mode: host` (Codespaces error 1302 — UnitiedContainerError-
    //   FatalCreatingContainer). Adding `privileged: true` would help DinD
    //   but conflicts with `network_mode: host` iptables management.
    // - `docker-outside-of-docker` would build, but the observability
    //   compose uses RELATIVE bind mounts (`./observability/grafana/...`)
    //   which are interpreted on the VM Docker daemon. Inside the dev
    //   container the workspace is at `/app/`; on the VM it lives under
    //   `/var/lib/docker/codespacemount/workspace/...`. Path mismatch →
    //   bind mounts fail.
    //
    // Until the Docker integration is re-engineered with path consistency
    // (workspaceFolder = `/workspaces/<repo>` matching the VM mount),
    // observability stack auto-start stays DORMANT in default Codespaces
    // — consistent with every other dormant capability in CLAUDE.md §6.6.
    // The `start_observability.sh` script detects the missing docker CLI
    // and exits cleanly with a clear message instead of failing the boot.
    // See CLAUDE.md §6.16 for the full rationale.
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.isort",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "humao.rest-client",
        "mechatroner.rainbow-csv",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "editor.rulers": [100],
        "editor.tabSize": 4,
        "files.trimTrailingWhitespace": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  }
}
