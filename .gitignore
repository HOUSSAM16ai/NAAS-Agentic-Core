# ==========================================
# === CogniForge .gitignore - Final Form ===
# ==========================================

# E2E local/sandbox runtime artifacts (D-098 / D-163) — never committed
.cogniforge_e2e.db*
.e2e_*.log
.e2e_env.sh
.e2e_d163.db*
.pr_body_*.md

# 1. Environment & Secrets
# Never commit secrets, keys, passwords, or local environment settings!
.env
.env.codespaces
.devcontainer/secrets.env
# ISS-091 (D-SECRET-002): SECRET_KEY الثابت يجب أن لا يُلتزم به في git أبداً.
# كل بيئة (Codespace, Gitpod, local) يجب أن تولِّد مفتاحها الخاص محلياً.
.devcontainer/state/dev_secret_key
.venv
.venv*/
venv/
ENV/
env/
instance/
test-api-key/
.pip_cache/

# Runtime observability artifacts — regenerated on every Codespace attach.
# The lock file IS committed (it is the drift baseline); the per-run
# snapshots are not.
.runtime/snapshot.txt
.runtime/truth_table.json
.runtime/path_map.json
!.runtime/truth_table.lock.json

# Observability stack runtime state — boot logs, container artifacts.
# The configs under observability/ ARE committed (declarative). The
# .observability/ directory holds ephemeral process artifacts.
.observability/*
!.observability/.gitkeep
!.observability/README.md

# 2. Python Byte-compiled / Caches
# These files are generated by Python and are not part of the source code.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# 3. Python Build Artifacts
# Files generated when building or distributing the package.
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg
MANIFEST

# 4. IDE / Editor Specific Files
# User-specific settings for code editors.
# `.vscode/*` (not `.vscode/`) so the negations below actually work for
# new files. Git's parent-directory exclusion swallows negations inside a
# fully-excluded directory; star-glob keeps the directory itself unmatched.
.vscode/*
!.vscode/mcp-settings.json
!.vscode/tasks.json
.cursor/
!.cursor/mcp.json
.idea/
*.swp
*.swo

# 5. Cloud Development Environment Specific
# This project is 100% controlled by the universal .devcontainer standard.
.gitpod.yml
# The .devcontainer itself is often kept, but you can ignore it if you want
# .devcontainer/

# 6. Docker Specific
# Ignore local overrides for docker-compose.
docker-compose.override.yml

# 7. Generic OS files
.DS_Store
Thumbs.db
# Ignore the locally generated Cogni CLI index
.cogni/

# 8. Code Quality & Linting Cache
# Files generated by linters and formatters
.mypy_cache/
.ruff_cache/
.pylint.d/
.tox/

# 9. Test Coverage & Reports
# Generated test reports and coverage files
junit.xml
.pytest_cache/
test-results/
coverage/
*.cover
.hypothesis/
logs/
attached_assets/

# 10. Documentation Build
# Generated documentation files
docs/_build/
docs/_static/
docs/_templates/
site/

# 11. Backup Files
# Backup files created by editors or tools
*.bak
*.backup
*.tmp
*~

# 12. Large Files (should use Git LFS)
# Prevent accidentally committing large files
*.log
*.sqlite
*.db
*.sql
# Tracked migrations are an exception — they are versioned schema, not dumps.
!scripts/migrations/*.sql
test_ai_enhancements.py
actionlint

# 13. Security Reports & Analysis
# Generated security scan reports (don't commit sensitive findings)
security-reports/
bandit-report.json
bandit-output.txt
bandit-summary.txt
safety-report.json
safety-output.txt
safety-summary.txt
semgrep-report.json
semgrep-output.txt
semgrep-summary.txt
semgrep.sarif
.semgrep_cache/
SBOM.txt
.env.security

# 14. SonarQube/SonarCloud
# SonarQube scanner working directory
.scannerwork/
.sonar/

# 15. Quality Metrics
# Generated quality metric reports
/tmp/check_output_*.log
quality-metrics.json

# 16. Node.js / Frontend Build Artifacts
# Node dependencies and build outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn
.pnp
.pnp.js

# Frontend build output
app/static/dist/
app/static/build/
*.tsbuildinfo

# Frontend cache
.vite/
.turbo/
.cache/
.parcel-cache/

# Environment files for frontend
.env.local
.env.development.local
.env.test.local
.env.production.local

# CI/CD Tools (temporary downloads)
actionlint*
.coverage.*
*.backup

# Auto-generated documentation
docs/generated/

.venv312/
.env
