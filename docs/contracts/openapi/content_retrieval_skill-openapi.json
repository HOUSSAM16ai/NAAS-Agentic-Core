            "title": "Requested",
            "description": "\u0639\u062f\u062f \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0633\u062d\u0628\u0647\u0627"
          },
          "item_name": {
            "type": "string",
            "title": "Item Name",
            "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0646\u0635\u0631 (\u0643\u0631\u0629\u060c \u0642\u0644\u0645\u060c \u0648\u0631\u0642\u0629...)",
            "default": "\u0643\u0631\u0629"
          }
        },
        "type": "object",
        "required": [
          "bag_count",
          "requested"
        ],
        "title": "ImpossibleCaseRequest",
        "description": "\u0637\u0644\u0628 \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0633\u062a\u062d\u064a\u0644\u0629.\n\n\u064a\u064f\u0631\u0633\u064e\u0644 \u0645\u0646 \u0627\u0644\u0640 frontend \u0639\u0646\u062f \u0628\u0646\u0627\u0621 \u0645\u0633\u0623\u0644\u0629 \u0627\u062d\u062a\u0645\u0627\u0644\u0627\u062a\n\u0642\u0628\u0644 \u0623\u064a \u062d\u0633\u0627\u0628 \u2014 \u0644\u062a\u062c\u0646\u0628 \u0639\u0631\u0636 \u0646\u062a\u0627\u0626\u062c \u0645\u0633\u062a\u062d\u064a\u0644\u0629 \u0644\u0644\u0637\u0627\u0644\u0628."
      },
      "ImpossibleCaseResponse": {
        "properties": {
          "is_impossible": {
            "type": "boolean",
            "title": "Is Impossible"
          },
          "case_type": {
            "type": "string",
            "title": "Case Type"
          },
          "stage_1": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage1SceneResponse"
