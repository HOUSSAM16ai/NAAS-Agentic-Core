{
  "openapi": "3.1.0",
  "info": {
    "title": "foundations-service",
    "description": "API-first deterministic 'first roots' compute Skill \u2014 D-183",
    "version": "1.0.0"
  },
  "paths": {
    "/compute": {
      "post": {
        "summary": "Compute Endpoint",
        "description": "Run one deterministic foundations operation (fail-open).",
        "operationId": "compute_endpoint_compute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComputeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComputeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Health probe \u2014 always healthy (no external dependency).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "description": "Prometheus metrics endpoint.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComputeRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Domain"
          },
          "operation": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Operation"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          }
        },
        "type": "object",
        "required": [
          "domain",
          "operation"
        ],
        "title": "ComputeRequest",
        "description": "Deterministic compute request \u2014 domain + operation + structured args."
      },
      "ComputeResponse": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "operation": {
            "type": "string",
            "title": "Operation"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "result": {
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "domain",
          "operation",
          "ok",
          "duration_ms"
        ],
        "title": "ComputeResponse",
        "description": "Deterministic compute response \u2014 result or a reported error (never raises)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "step": {
            "type": "string",
            "title": "Step"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Domains"
          },
          "llm_backend": {
            "type": "string",
            "title": "Llm Backend"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "step",
          "version",
          "domains",
          "llm_backend"
        ],
        "title": "HealthResponse",
        "description": "Health probe."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}