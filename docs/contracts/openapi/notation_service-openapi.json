{
  "openapi": "3.1.0",
  "info": {
    "title": "notation-service",
    "description": "API-first deterministic mathematical-notation Skill \u2014 D-185",
    "version": "1.0.0"
  },
  "paths": {
    "/resolve": {
      "post": {
        "summary": "Resolve Endpoint",
        "description": "\u064a\u062d\u0648\u0651\u0644 \u0633\u0624\u0627\u0644 \u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u062d\u0631\u0651 \u0625\u0644\u0649 \u0631\u0645\u0632 \u0645\u064f\u0639\u0631\u064e\u0651\u0641 \u2014 \u062d\u062a\u0645\u064a\u060c fail-open.",
        "operationId": "resolve_endpoint_resolve_post",
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Correlation-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/define": {
      "post": {
        "summary": "Define Endpoint",
        "description": "\u064a\u064f\u0631\u062c\u0639 \u062a\u0639\u0631\u064a\u0641 \u0631\u0645\u0632\u064d \u0628\u0639\u064a\u0646\u0647 \u2014 \u0631\u0645\u0632 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641 \u21d2 \u062e\u0637\u0623 \u0645\u064f\u0647\u064a\u0643\u064e\u0644 \u0644\u0627 \u0627\u0633\u062a\u062b\u0646\u0627\u0621.",
        "operationId": "define_endpoint_define_post",
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Correlation-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefineRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DefineResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/symbols": {
      "get": {
        "summary": "Symbols Endpoint",
        "description": "\u064a\u064f\u0631\u062c\u0639 \u0627\u0644\u0633\u062c\u0644\u0651 \u0643\u0627\u0645\u0644\u0627\u064b \u2014 \u0645\u0635\u062f\u0631 \u0628\u0648\u0651\u0627\u0628\u0629 \u00ab\u0644\u0627 \u0631\u0645\u0632 \u064a\u062a\u064a\u0645\u00bb \u0648\u0627\u0644\u0648\u0643\u0644\u0627\u0621.",
        "operationId": "symbols_endpoint_symbols_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SymbolsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "\u0641\u062d\u0635 \u0635\u062d\u0651\u0629 \u0628\u062d\u0642\u0648\u0644 \u062c\u0627\u0647\u0632\u064a\u0629 \u2014 \u0633\u062c\u0644\u0651 \u0641\u0627\u0631\u063a \u064a\u0639\u0646\u064a `degraded` \u0644\u0627 `healthy`.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "description": "Prometheus metrics endpoint.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DefineRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Symbol"
          }
        },
        "type": "object",
        "required": [
          "symbol"
        ],
        "title": "DefineRequest",
        "description": "\u0627\u0633\u062a\u0639\u0644\u0627\u0645 \u062a\u0639\u0631\u064a\u0641 \u0631\u0645\u0632\u064d \u0628\u0639\u064a\u0646\u0647 (`C`, `n!`, `P_A(B)` \u2026)."
      },
      "DefineResponse": {
        "properties": {
          "found": {
            "type": "boolean",
            "title": "Found"
          },
          "symbol": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SymbolPayload"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "registry_version": {
            "type": "string",
            "title": "Registry Version"
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "found",
          "registry_version",
          "duration_ms",
          "trace_id"
        ],
        "title": "DefineResponse",
        "description": "\u062a\u0639\u0631\u064a\u0641 \u0631\u0645\u0632 \u2014 \u0623\u0648 `found=false` \u0645\u0639 \u0633\u0628\u0628 \u0645\u064f\u0647\u064a\u0643\u064e\u0644."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "step": {
            "type": "string",
            "title": "Step"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "registry_version": {
            "type": "string",
            "title": "Registry Version"
          },
          "symbols_loaded": {
            "type": "integer",
            "title": "Symbols Loaded"
          },
          "startup_state": {
            "type": "string",
            "title": "Startup State"
          },
          "llm_backend": {
            "type": "string",
            "title": "Llm Backend"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "step",
          "version",
          "registry_version",
          "symbols_loaded",
          "startup_state",
          "llm_backend"
        ],
        "title": "HealthResponse",
        "description": "\u0641\u062d\u0635 \u0627\u0644\u0635\u062d\u0651\u0629 \u0628\u062d\u0642\u0648\u0644 \u062c\u0627\u0647\u0632\u064a\u0629 \u062d\u0642\u064a\u0642\u064a\u0629 \u2014 \u00abDegraded \u2260 Dead\u00bb (CLAUDE.md \u00a70)."
      },
      "ResolveRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ResolveRequest",
        "description": "\u0646\u0635\u0651 \u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u062d\u0631\u0651 \u0643\u0645\u0627 \u0648\u0635\u0644 \u2014 \u0628\u0644\u0627 \u0623\u064a \u0645\u0639\u0627\u0644\u062c\u0629 \u0645\u0633\u0628\u0642\u0629."
      },
      "ResolveResponse": {
        "properties": {
          "found": {
            "type": "boolean",
            "title": "Found"
          },
          "symbol": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SymbolPayload"
              },
              {
                "type": "null"
              }
            ]
          },
          "registry_version": {
            "type": "string",
            "title": "Registry Version"
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "found",
          "registry_version",
          "duration_ms",
          "trace_id"
        ],
        "title": "ResolveResponse",
        "description": "\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u2014 `found=false` \u062c\u0648\u0627\u0628 \u0645\u0634\u0631\u0648\u0639 \u0644\u0627 \u062e\u0637\u0623."
      },
      "SymbolPayload": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "definition": {
            "type": "string",
            "title": "Definition"
          },
          "example": {
            "type": "string",
            "title": "Example"
          },
          "concept_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept Id"
          },
          "property_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Property Id"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "title",
          "definition",
          "example"
        ],
        "title": "SymbolPayload",
        "description": "\u0631\u0645\u0632 \u0645\u064f\u0639\u0631\u064e\u0651\u0641 \u0643\u0645\u0627 \u064a\u064f\u0633\u0644\u064e\u0651\u0645 \u0639\u0628\u0631 \u0627\u0644\u0639\u0642\u062f."
      },
      "SymbolsResponse": {
        "properties": {
          "symbols": {
            "items": {
              "$ref": "#/components/schemas/SymbolPayload"
            },
            "type": "array",
            "title": "Symbols"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "registry_version": {
            "type": "string",
            "title": "Registry Version"
          }
        },
        "type": "object",
        "required": [
          "symbols",
          "count",
          "registry_version"
        ],
        "title": "SymbolsResponse",
        "description": "\u0627\u0644\u0633\u062c\u0644\u0651 \u0643\u0627\u0645\u0644\u0627\u064b \u2014 \u064a\u064f\u063a\u0630\u0651\u064a \u0628\u0648\u0651\u0627\u0628\u0627\u062a CI \u0648\u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u064a\u064a\u0646."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}