  "components": {
    "schemas": {
      "DecisionResponse": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "decision_level": {
            "type": "string",
            "title": "Decision Level"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "human_action_description": {
            "type": "string",
            "title": "Human Action Description"
          },
          "decision_log": {
            "additionalProperties": true,
            "type": "object",
            "title": "Decision Log"
          }
        },
        "type": "object",
        "required": [
          "allowed",
          "decision_level",
          "reason",
          "human_action_description",
          "decision_log"
        ],
        "title": "DecisionResponse"
      },
      "DialogueRequest": {
        "properties": {
          "stakeholder": {
            "type": "string",
            "title": "Stakeholder",
            "description": "employer | worker | union | government | educator | citizen"
          },
          "feedback_text": {
            "type": "string",
            "title": "Feedback Text",
            "description": "\u0646\u0635 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0645\u0646 \u0627\u0644\u0623\u0637\u0631\u0627\u0641 \u0627\u0644\u0645\u0639\u0646\u064a\u0629"
          }
        },
        "type": "object",
        "required": [
          "stakeholder",
          "feedback_text"
        ],
        "title": "DialogueRequest",
        "description": "\u0648\u0643\u064a\u0644 \u0627\u0644\u062d\u0648\u0627\u0631 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u2014 \u0645\u062e\u0631\u062c\u0647 \u00a78-11."
      },
      "EarlyWarningRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "title": "Scope",
            "description": "national | sector | individual",
            "default": "national"
          },
          "occupation_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Occupation Codes",
            "description": "\u0625\u0646 \u0644\u0645 \u064a\u064f\u0630\u0643\u0631: \u0643\u0644 \u0623\u0637\u0644\u0633 \u0627\u0644\u0645\u0647\u0646"
          },
          "worker": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkerInput"
              },
              {
                "type": "null"
              }
            ],
            "description": "\u0644\u062a\u062d\u0644\u064a\u0644 \u0641\u0631\u062f\u064a"
          }
        },
        "type": "object",
        "title": "EarlyWarningRequest",
        "description": "\u0648\u0643\u064a\u0644 \u0627\u0644\u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u0645\u0628\u0643\u0631 \u2014 \u0645\u062e\u0631\u062c\u0647 \u00a78-1: \u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 + \u0642\u0627\u0626\u0645\u0629 \u0625\u0646\u0630\u0627\u0631\u0627\u062a."
      },
      "EducationRequest": {
        "properties": {
          "institution_type": {
            "type": "string",
            "title": "Institution Type",
            "description": "general | vocational | school",
            "default": "general"
          },
          "target_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Target Skills",
            "description": "\u0627\u0644\u0645\u0647\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0641\u064a \u0627\u0644\u0633\u0648\u0642"
          },
          "current_curriculum_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Current Curriculum Skills",
            "description": "\u0627\u0644\u0645\u0647\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u063a\u0637\u064a\u0647\u0627 \u0627\u0644\u0645\u0646\u0647\u062c"
          },
          "for_occupation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "For Occupation"
          }
        },
        "type": "object",
        "title": "EducationRequest",
        "description": "\u0648\u0643\u064a\u0644 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u2014 \u0645\u062e\u0631\u062c\u0647 \u00a78-5: \u062a\u062d\u0644\u064a\u0644 \u0645\u0646\u0627\u0647\u062c + \u0648\u062d\u062f\u0627\u062a \u062a\u062f\u0631\u064a\u0628 \u0642\u0635\u064a\u0631\u0629."
      },
      "EquityRequest": {
        "properties": {
          "population": {
            "items": {
              "$ref": "#/components/schemas/WorkerInput"
            },
            "type": "array",
            "title": "Population",
            "description": "\u0639\u064a\u0646\u0629 \u0633\u0643\u0627\u0646\u064a\u0629 \u0644\u0644\u062a\u062d\u0644\u064a\u0644"
          }
        },
        "type": "object",
        "required": [
          "population"
        ],
        "title": "EquityRequest",
        "description": "\u0648\u0643\u064a\u0644 \u0627\u0644\u0639\u062f\u0627\u0644\u0629 \u2014 \u0645\u062e\u0631\u062c\u0647 \u00a78-9."
      },
      "EvaluationRequest": {
        "properties": {
          "kpi_code": {
            "type": "string",
            "title": "Kpi Code",
            "description": "transition_completion_rate | six_month_placement | wage_change | gender_gap_closure | rural_access"
          },
          "measured_value": {
            "type": "number",
            "title": "Measured Value"
          },
          "target_value": {
            "type": "number",
            "title": "Target Value"
          },
          "period": {
            "type": "string",
            "title": "Period",
            "description": "current | previous",
            "default": "current"
          }
        },
        "type": "object",
        "required": [
          "kpi_code",
          "measured_value",
          "target_value"
        ],
        "title": "EvaluationRequest",
        "description": "\u0648\u0643\u064a\u0644 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0648\u0627\u0644\u0645\u0633\u0627\u0621\u0644\u0629 \u2014 \u0645\u062e\u0631\u062c\u0647 \u00a78-12."
      },
      "ExposureRequest": {
        "properties": {
          "occupation_code": {
            "type": "string",
            "title": "Occupation Code"
          },
          "task_breakdown": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Breakdown",
            "description": "\u0645\u0647\u0627\u0645 \u0645\u062e\u0635\u0635\u0629 {label_ar, label_en, category, time_fraction} \u0644\u062a\u0642\u064a\u064a\u0645 \u0645\u0647\u0646\u0629 \u063a\u064a\u0631 \u0645\u0633\u062c\u0644\u0629"
          }
        },
        "type": "object",
        "required": [
          "occupation_code"
        ],
        "title": "ExposureRequest",
        "description": "\u0648\u0643\u064a\u0644 \u0627\u0644\u062a\u0639\u0631\u0636 \u0627\u0644\u0645\u0647\u0646\u064a \u2014 \u0645\u062e\u0631\u062c\u0647 \u00a78-2."
      },
      "GovernanceApprovalRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "agent": {
            "type": "string",
            "title": "Agent",
