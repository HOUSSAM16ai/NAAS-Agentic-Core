{
  "$schema_version": "1",
  "decision": "D-270",
  "law": "L6 — سلسلة التوريد تُبرَّد وتَصِف الموجود",
  "purpose_ar": "المصدر القانوني الوحيد لانضباط سلسلة التوريد. تحرسه scripts/fitness/check_supply_chain.py.",
  "rules_ar": [
    "التبريد إلزامي: نسخةٌ رُفعت للتوّ لا تُدمَج آلياً — وهو الحاجز العملي الوحيد أمام حزمةٍ مُختطَفة.",
    "ملفّ Dependabot يصف ما هو موجود: مجلّدٌ غير موجود أو مجموعةُ حزمٍ لا تطابق شيئاً وعدٌ بتغطيةٍ لا تحدث.",
    "منظومةٌ موجودة في المستودع وغير مُغطّاة = فجوةٌ صامتة (frontend/package.json بقي بلا تغطية حتى D-270).",
    "مفتاحٌ مُهمَل يتجاهله Dependabot بصمت يُقرأ حمايةً وليس حماية (reviewers/assignees).",
    "دَين التثبيت مُجمَّد ويتقلّص في الاتجاهين: تبعيةٌ جديدة غير مُثبَّتة ⇒ أحمر، ودَينٌ أُغلق بلا حذفه من هنا ⇒ أحمر أيضاً."
  ],
  "dependabot": {
    "config_path": ".github/dependabot.yml",
    "required_cooldown_days": 7,
    "deprecated_keys": [
      "reviewers",
      "assignees"
    ],
    "required_ecosystems": {
      "pip": "requirements*.txt في الجذر",
      "npm": "frontend/package.json",
      "docker": "١٦ Dockerfile عبر الجذر والواجهة والخدمات المصغّرة",
      "github-actions": ".github/workflows/*.yml"
    }
  },
