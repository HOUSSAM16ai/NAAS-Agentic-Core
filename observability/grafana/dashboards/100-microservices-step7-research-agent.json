  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Research Agent — Startup Info",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 1 }] } } },
      "targets": [{ "expr": "cogniforge_research_startup_info", "legendFormat": "step={{step}} tavily={{tavily_available}} env={{environment}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tavily Web Search",
      "gridPos": { "x": 6, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DISABLED" }, "1": { "text": "ACTIVE" } } }] } },
      "targets": [{ "expr": "cogniforge_research_startup_info{tavily_available=\"true\"}", "legendFormat": "Tavily", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP Request Rate",
      "gridPos": { "x": 10, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "targets": [{ "expr": "rate(cogniforge_research_requests_total[2m])", "legendFormat": "req/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }]
    },
