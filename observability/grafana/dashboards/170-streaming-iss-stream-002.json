  "panels": [
    {
      "id": 1,
      "title": "Streaming Chunks/sec (Word-by-Word Rate)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(cogniforge_streaming_chunks_total[1m])",
