  "liveNow": true,
  "panels": [
    {
      "type": "text", "title": "", "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 }, "id": 1,
      "options": { "mode": "html", "code": { "language": "html" }, "content": "<div style='background:linear-gradient(135deg,#1d3a23 0%,#2c5e3a 100%);padding:14px 24px;border-radius:8px;color:#fff;font-family:Inter,system-ui,sans-serif;'><div style='font-size:20px;font-weight:700;'>🌐 HTTP API Surface</div><div style='font-size:12px;opacity:0.85;margin-top:4px;'>All non-WS HTTP traffic: 9 routers mounted via <code>app/api/routers/registry.py</code>.</div></div>" }
    },
    {
      "type": "stat", "title": "Req/s", "gridPos": { "h": 5, "w": 4, "x": 0, "y": 3 }, "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(cogniforge_http_requests_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 1, "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue" }, { "color": "green", "value": 0.5 }] } } },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Error Rate (5m)", "gridPos": { "h": 5, "w": 4, "x": 4, "y": 3 }, "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * sum(rate(cogniforge_http_errors_total[5m])) / clamp_min(sum(rate(cogniforge_http_requests_total[5m])), 1)", "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 2, "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "p95 Latency", "gridPos": { "h": 5, "w": 4, "x": 8, "y": 3 }, "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(cogniforge_http_request_duration_seconds_bucket[5m])) by (le))", "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 3, "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] } } },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" }
    },
    {
      "type": "timeseries", "title": "Top 10 Endpoints by req/s", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 3 }, "id": 20,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(10, sum by (endpoint) (rate(cogniforge_http_requests_total[5m])))", "refId": "A", "legendFormat": "{{endpoint}}" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "smooth", "lineWidth": 2 }, "unit": "reqps" } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "heatmap", "title": "Latency Heatmap (all routes)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 }, "id": 30,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (le) (rate(cogniforge_http_request_duration_seconds_bucket[2m]))", "refId": "A", "legendFormat": "{{le}}", "format": "heatmap" }],
      "options": { "calculate": false, "cellGap": 1, "color": { "scheme": "Spectral", "mode": "scheme", "exponent": 0.5, "steps": 64, "reverse": true }, "yAxis": { "axisPlacement": "left", "unit": "s", "decimals": 1 }, "legend": { "show": true } }
    },
    {
      "type": "timeseries", "title": "5xx Errors by Endpoint",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 }, "id": 31,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (endpoint) (rate(cogniforge_http_errors_total{status=~\"5..\"}[2m]))", "refId": "A", "legendFormat": "{{endpoint}}" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1 }, "unit": "ops" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ],
  "refresh": "10s",
