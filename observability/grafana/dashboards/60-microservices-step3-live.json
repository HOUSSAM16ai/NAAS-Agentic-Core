      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "rate(cogniforge_langgraph_intent_total{intent=\"educational\"}[5m])",
          "legendFormat": "educational",
          "refId": "A"
        },
        {
          "expr": "rate(cogniforge_langgraph_intent_total{intent=\"chat\"}[5m])",
          "legendFormat": "chat",
          "refId": "B"
        },
        {
          "expr": "rate(cogniforge_langgraph_intent_total{intent=\"general\"}[5m])",
          "legendFormat": "general",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Fallback Chain Progress",
      "description": "تتبع تقدم سلسلة الـ fallback — كلما انخفض fallback كلما نجح الـ orchestrator",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "rate(cogniforge_routing_target_total{target=\"/api/chat/messages\"}[5m])",
          "legendFormat": "Tier 0: Orchestrator (target)",
          "refId": "A"
        },
        {
          "expr": "rate(cogniforge_langgraph_node_count_total[5m])",
          "legendFormat": "Tier 3: LangGraph local (fallback)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Microservices Health Matrix",
      "description": "حالة جميع الخدمات المصغرة — UP / DOWN",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Service", "desc": false }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP ✅", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN ❌", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{tier=\"microservice\"}",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "rows" } }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
