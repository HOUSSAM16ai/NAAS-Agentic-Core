{
  "uid": "cogniforge-ms-step3-live",
  "title": "🔥 Microservices Step 3 — Live Activation",
  "description": "مراقبة حية لـ orchestrator-service بعد تفعيل الخطوة الانتقالية الثالثة",
  "tags": ["cogniforge", "microservices", "step3", "orchestrator", "live"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Orchestrator Service Status",
      "description": "حالة orchestrator-service الحية — ok / degraded / down",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "LIVE ✅", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN ❌", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "up{job=\"orchestrator-service\"}",
          "legendFormat": "orchestrator",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Routing Mode",
      "description": "1 = StateGraph (Step 3 active) | 0 = Agent (fallback)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "StateGraph ✅", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "Agent Mode", "color": "yellow" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "cogniforge_routing_mode_state_graph",
          "legendFormat": "routing_mode",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Orchestrator Requests (5m)",
      "description": "عدد الطلبات الواصلة لـ orchestrator-service في آخر 5 دقائق",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(cogniforge_routing_target_total{target=\"/api/chat/messages\"}[5m])",
          "legendFormat": "→ StateGraph",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Graph Ready",
      "description": "هل StateGraph (13 عقدة) مُجمَّع وجاهز؟",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "Ready ✅", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "Not Ready ❌", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "up{job=\"orchestrator-service\"}",
          "legendFormat": "graph_ready",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Postgres Orchestrator",
      "description": "حالة قاعدة بيانات orchestrator المستقلة (port 5441)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP ✅", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "DOWN ❌", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "up{job=\"orchestrator-service\"}",
          "legendFormat": "postgres-orchestrator",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Step 3 Activation",
      "description": "تاريخ تفعيل الخطوة الانتقالية الثالثة",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        }
      },
      "targets": [
        {
          "expr": "process_start_time_seconds{job=\"orchestrator-service\"} * 1000",
          "legendFormat": "Started",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Routing Target Distribution",
      "description": "توزيع الطلبات بين StateGraph و Agent fallback عبر الزمن",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "rate(cogniforge_routing_target_total{target=\"/api/chat/messages\"}[2m])",
          "legendFormat": "→ StateGraph (/api/chat/messages)",
          "refId": "A"
        },
        {
          "expr": "rate(cogniforge_routing_target_total{target=\"/agent/chat\"}[2m])",
          "legendFormat": "→ Agent (/agent/chat)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LangGraph Node Execution Rate",
      "description": "معدل تنفيذ عقد StateGraph (supervisor + chat) عبر الزمن",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rate(cogniforge_langgraph_node_count_total{node=\"supervisor\"}[2m])",
          "legendFormat": "supervisor_node",
          "refId": "A"
        },
        {
          "expr": "rate(cogniforge_langgraph_node_count_total{node=\"chat\"}[2m])",
          "legendFormat": "chat_node",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Orchestrator HTTP Request Rate",
      "description": "معدل طلبات HTTP لـ orchestrator-service مصنفة حسب الحالة",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"orchestrator-service\",status=~\"2..\"}[2m])",
          "legendFormat": "2xx Success",
          "refId": "A"
        },
        {
          "expr": "rate(http_requests_total{job=\"orchestrator-service\",status=~\"5..\"}[2m])",
          "legendFormat": "5xx Error",
          "refId": "B"
        },
        {
          "expr": "rate(http_requests_total{job=\"orchestrator-service\",status=~\"4..\"}[2m])",
          "legendFormat": "4xx Client Error",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LangGraph Node Duration (p50/p95/p99)",
      "description": "زمن تنفيذ عقد StateGraph — percentiles",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(cogniforge_langgraph_node_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(cogniforge_langgraph_node_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(cogniforge_langgraph_node_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Intent Classification Distribution",
      "description": "توزيع نوايا المستخدمين (educational / chat / general) عبر الزمن",
