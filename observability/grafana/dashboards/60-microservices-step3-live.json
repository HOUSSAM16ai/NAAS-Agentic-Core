    {
      "id": 17,
      "type": "stat",
      "title": "Orchestrator Uptime",
      "description": "مدة تشغيل orchestrator-service منذ الإقلاع",
      "gridPos": { "x": 12, "y": 36, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
