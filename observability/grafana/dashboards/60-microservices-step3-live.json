    {
      "id": 18,
      "type": "stat",
      "title": "Orchestrator CPU Usage",
      "description": "استهلاك CPU لـ orchestrator-service",
      "gridPos": { "x": 18, "y": 36, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
